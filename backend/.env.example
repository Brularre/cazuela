SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=your-service-role-key

# Meta — WhatsApp webhook + OTP sending
META_APP_SECRET=your-meta-app-secret
META_PHONE_NUMBER_ID=your-phone-number-id
META_ACCESS_TOKEN=your-permanent-access-token
META_WEBHOOK_VERIFY_TOKEN=pick-any-random-string

# Dashboard auth — generate with: openssl rand -hex 32
SESSION_SECRET=

# Export endpoint protection
EXPORT_TOKEN=replace-with-a-secret-token

# AI — legacy vars (deprecated, still work; prefer CLASSIFIER_* / RESPONDER_* below)
ANTHROPIC_API_KEY=sk-ant-your-key-here
USE_AI_AGENT=false

# AI — two-tier model config (classifier = intent routing, responder = conversational)
# CLASSIFIER_PROVIDER=anthropic        # anthropic | groq | stub | none
# CLASSIFIER_API_KEY=sk-ant-your-key
# CLASSIFIER_MODEL=claude-haiku-4-5-20251001
# RESPONDER_PROVIDER=anthropic
# RESPONDER_API_KEY=sk-ant-your-key
# RESPONDER_MODEL=claude-haiku-4-5-20251001

# Dashboard URL — sent to users via the 'tablero' WhatsApp command
DASHBOARD_URL=https://your-frontend.up.railway.app

# Backend public URL — used to build iCal subscribe URLs in the dashboard
# (must be the backend's public hostname, not the frontend's)
BACKEND_URL=https://your-backend.up.railway.app
